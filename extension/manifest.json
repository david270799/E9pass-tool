{
  "manifest_version": 3,
  "name": "E9pay — автозаполнение",
  "version": "0.2.0",
  "description": "Заполняет форму заявки KICA данными клиента из программы E9pay на этом компьютере. Данные не уходят в интернет.",
  "key": "",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "16": "icon16.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "E9pay — заполнить форму"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.signra.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.signra.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}